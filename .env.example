# Copy this file to a new .env file and fill in the values.
# The default below matches compose.yaml's local postgres service and works
# as-is for local dev; point it at Neon instead for a hosted database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/selfos
NEON_DATABASE_URL="INSERT_URL_IN_QUOTES"

# Auth (decision 07 on the neon map). AUTH_PASSWORD_HASH is a bcrypt hash —
# generate one from apps/api with: go run ./cmd/hashpassword "your-password".
# MUST be single-quoted: a bcrypt hash's own $2a$10$... segments look like
# shell variable references to godotenv's interpolation, and it will
# silently mangle an unquoted value (verify with `go run ./cmd/hashpassword`
# then checking the login endpoint actually accepts it, not just that the
# server starts). SESSION_SECRET signs the session cookie — any long random
# string, e.g. `openssl rand -hex 32`; no $ signs, so no quoting needed.
# Never commit real values here.
AUTH_PASSWORD_HASH=''
SESSION_SECRET=
